{
  "name": "sbt-control-plane",
  "version": "1.0.0",
  "description": "SBT-based control plane for the multi-tenant EHR SaaS demo",
  "private": true,
  "bin": {
    "sbt-control-plane": "bin/control-plane.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "synth": "cdk synth --all"
  },
  "jest": {
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testMatch": [
      "**/test/**/*.ts"
    ],
    "moduleNameMapper": {
      "^@cdklabs/sbt-aws$": "<rootDir>/node_modules/@cdklabs/sbt-aws/lib/index.js"
    }
  },
  "dependencies": {
    "@cdklabs/sbt-aws": "^0.9.5",
    "aws-cdk-lib": "^2.195.0",
    "constructs": "^10.4.2",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-eventbridge": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@types/aws-lambda": "^8.10.147",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "aws-cdk": "^2.1128.1",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3"
  }
}
